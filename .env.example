# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_key_here
# LLM_BACKEND=groq | gemini | mixed | local | hybrid | openai | mock
LLM_BACKEND=groq
# Or use Google Gemini (key from https://aistudio.google.com/apikey):
# LLM_BACKEND=gemini
# GEMINI_API_KEY=your_key_here

# Local GPU model (e.g. Intel Arc A770) served by LM Studio / Ollama / llama.cpp.
# hybrid = local generator + Gemini judge + Gemini long-context + Groq dense tier (needs GEMINI_API_KEY and GROQ_API_KEY)
# local  = everything on the local model (no keys needed)
# LLM_BACKEND=hybrid
# LOCAL_BASE_URL=http://localhost:1234/v1      # LM Studio (Ollama: http://localhost:11434/v1)
# LOCAL_MODEL=auto                             # or the exact id, e.g. qwen2.5-14b-instruct
# EMBED_DEVICE=cpu                             # cpu | xpu | cuda | auto
# LOCAL_FALLBACK=1                             # 0 = stop with an error if the local server fails instead of using cloud models
# LLM_TRACE=llm_trace.jsonl                    # optional: log purpose/model/cache-hit/response head of every LLM call
